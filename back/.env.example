# Database Configuration (NeonDB)
DATABASE_URL='postgresql://usuario:password@host:port/database?sslmode=require'

# JWT Configuration
JWT_SECRET='tu-clave-secreta-jwt-muy-segura'

# Clerk Configuration (for admin authentication)
CLERK_SECRET_KEY='sk_test_tu_clave_secreta_de_clerk'

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URLs (for CORS)
FRONTEND_URL=http://localhost:5173

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Google Authenticator Configuration
TOTP_ISSUER='Jarana Sistema Horario'
TOTP_WINDOW=2

# Production URLs (for deployment)
# ADMIN_DOMAIN=admin.jarana.com
# KIOSK_DOMAIN=kiosk.jarana.com
